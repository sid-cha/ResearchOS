# Create a free Alpaca paper account and copy its market-data credentials here.
# Keep this file local; never upload it to GitHub or static Vercel deployments.
APCA_API_KEY_ID=replace_with_your_paper_api_key
APCA_API_SECRET_KEY=replace_with_your_paper_api_secret
PORT=8000
HOST=127.0.0.1
# SEC requires a declared application User-Agent including contact email.
# Example only; replace with your own contact email, and never commit .env.
SEC_USER_AGENT=TradeScopeResearch contact@example.com

# Optional local persistence paths. Defaults stay under .local-data/ and are ignored by Git.
# CASE_STORE_PATH=C:/Users/you/ResearchOS-data/cases.json
# RESEARCH_STORE_PATH=C:/Users/you/ResearchOS-data/research.json
# MONITOR_STORE_PATH=C:/Users/you/ResearchOS-data/monitors.json

# Optional Java/PostgreSQL metric snapshot bridge. Leave commented for Node-only use.
# Use the same private, unquoted 24-512 character token in the Java server environment.
# The browser never receives this token. Only local loopback HTTP origins are supported.
# RESEARCH_JAVA_ORIGIN=http://127.0.0.1:8080
# RESEARCH_API_TOKEN=replace_with_a_new_private_random_token

# Optional: grounded natural-language analyst briefs (server only). Leave unset for deterministic evidence engine.
# OPENAI_API_KEY=replace_with_your_api_key
# OPENAI_MODEL=gpt-6-luna

# Local-only, explicitly enabled SEC filing archival capture. Never enable on a public deployment.
# REGULATORY_LOCAL_CAPTURE_ENABLED=true

# Optional historical point-in-time economic data from FRED/ALFRED.
# Get a free API key from https://fred.stlouisfed.org/docs/api/api_key.html
# Server-side only; NEVER place this key in a browser, URL or committed .env.
# Supports official FRED/ALFRED source discovery, vintage dates, releases and as-of values.
# FRED_API_KEY=replace_with_your_NEW_32_character_api_key

# v0.19 opt-in commodity fundamentals sources for the commodity research pilot.
# Server-side only; never place these keys in a browser or committed .env.
# EIA API v2 natural-gas observations: https://www.eia.gov/opendata/register.php
# EIA registration activation link is NOT an API key. Rotate disclosed keys before use.
# EIA_API_KEY=replace_with_your_NEW_eia_key
# USDA FAS PSD data require an API.data.gov key: https://api.data.gov/signup/
# API.data.gov issues the USDA FAS PSD key. Use a freshly rotated key.
# USDA_FAS_API_KEY=replace_with_your_NEW_api_data_gov_key
# Optional: UN Comtrade registered subscription key raises the keyless preview limits.
# COMTRADE_SUBSCRIPTION_KEY=replace_with_your_NEW_primary_comtrade_key
# Optional manual backup only; do not rotate keys automatically to bypass provider limits:
# COMTRADE_SUBSCRIPTION_KEY_SECONDARY=replace_with_your_NEW_backup_comtrade_key
# Key registration (optional): https://comtradeplus.un.org/MyComtrade/APIPortal

# v0.17 opt-in licensed long-history SPY outcomes for 2008 research.
# The free EODHD tier does not cover 2008. Subscription and usage rights required.
# Adjusted prices are only used as retrospective outcome labels, not early-warning inputs.
# Never place a data token in a browser, committed env file or public API response.
# EODHD_API_TOKEN=replace_with_your_eodhd_key
# EODHD_INTERNAL_RESEARCH_ENABLED=true

# v0.25 optional LOCAL ISSUER FACILITY EVIDENCE CLAIMS. Disabled by default.
# Public USGS earthquake GeoJSON requires no API key.
# Never present analyst-submitted coordinates as verified facility damage or company risk.
# Enable only with HOST=127.0.0.1, localhost or ::1.
# RESEARCH_GEO_ASSET_REGISTRY_ENABLED=true

# v0.24 opt-in local source evidence journal. Off by default.
# Only enable after reviewing local storage and provider license restrictions.
# The JSONL journal stays under .local-data/ (ignored by Git); no multi-user auth.
# Requires loopback HOST=127.0.0.1 (or localhost/::1).
# RESEARCH_EVIDENCE_LEDGER_ENABLED=true

# Future Research Agent Desk ONLY — not used by v0.22. Obtain a developer key at:
# https://build.nvidia.com/settings/keys
# NVIDIA_API_KEY=replace_with_your_NEW_nvidia_developer_key
