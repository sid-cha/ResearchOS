# Create a free Alpaca paper account and copy its market-data credentials here.
# Keep this file local; never upload it to GitHub or static Vercel deployments.
APCA_API_KEY_ID=replace_with_your_paper_api_key
APCA_API_SECRET_KEY=replace_with_your_paper_api_secret
PORT=8000
HOST=127.0.0.1
# SEC requires a declared application User-Agent including contact email.
# Example only; replace with your own contact email, and never commit .env.
SEC_USER_AGENT=TradeScopeResearch contact@example.com

# Optional local persistence paths. Defaults stay under .local-data/ and are ignored by Git.
# CASE_STORE_PATH=C:/Users/you/ResearchOS-data/cases.json
# RESEARCH_STORE_PATH=C:/Users/you/ResearchOS-data/research.json
# MONITOR_STORE_PATH=C:/Users/you/ResearchOS-data/monitors.json

# Optional Java/PostgreSQL metric snapshot bridge. Leave commented for Node-only use.
# Use the same private, unquoted 24-512 character token in the Java server environment.
# The browser never receives this token. Only local loopback HTTP origins are supported.
# RESEARCH_JAVA_ORIGIN=http://127.0.0.1:8080
# RESEARCH_API_TOKEN=replace_with_a_new_private_random_token

# Optional: grounded natural-language analyst briefs (server only). Leave unset for deterministic evidence engine.
# OPENAI_API_KEY=replace_with_your_api_key
# OPENAI_MODEL=gpt-6-luna

# Local-only, explicitly enabled SEC filing archival capture. Never enable on a public deployment.
# REGULATORY_LOCAL_CAPTURE_ENABLED=true

# Optional historical point-in-time economic data from FRED/ALFRED.
# Get a free API key from https://fred.stlouisfed.org/docs/api/api_key.html
# Server-side only; NEVER place this key in a browser, URL or committed .env.
# FRED_API_KEY=replace_with_your_32_character_api_key
